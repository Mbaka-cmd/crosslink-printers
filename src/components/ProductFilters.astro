---
interface Props { hasPrices: boolean; }
const { hasPrices } = Astro.props;
---
<form class:list={['cfilters', { 'cfilters--price': hasPrices }]} role="search" id="catalogue-form" novalidate>
  <div class="field field--search">
    <label for="product-search" class="visually-hidden">Search products</label>
    <input id="product-search" type="search" placeholder="Search products..." autocomplete="off" />
  </div>
  {hasPrices && (
    <div class="field field--price">
      <label for="product-price">Price</label>
      <select id="product-price">
        <option value="any">All prices</option>
        <option value="lt1000">Under KES 1,000</option>
        <option value="1000-10000">KES 1,000 to 10,000</option>
        <option value="gt10000">Over KES 10,000</option>
        <option value="quote">Request a quote</option>
      </select>
    </div>
  )}
  <div class="field field--sort">
    <label for="product-sort">Sort</label>
    <select id="product-sort">
      <option value="featured">Featured</option>
      <option value="name">Name</option>
      {hasPrices && <option value="price-asc">Price: Low to High</option>}
      {hasPrices && <option value="price-desc">Price: High to Low</option>}
    </select>
  </div>
</form>