---
interface Props { eyebrow: string; title: string; lead?: string; }
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="display" set:html={title} />
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>