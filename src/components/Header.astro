---
import { site, waLink, mapsLink } from '../data/site';
import { nav } from '../data/nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const phone = site.phones[0];
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="brand" href="/">
      <span class="brand__name">{site.shortName}</span>
      <span class="brand__sub">PRINTERS / NKUBU</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-wa" href={waLink()} target="_blank" rel="noopener noreferrer">
      WhatsApp <span aria-hidden="true">&nearr;</span><span class="visually-hidden"> (opens in a new tab)</span>
    </a>

    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="mobile-menu on-ink" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <div class="mobile-menu__inner">
    <div class="mobile-menu__top">
      <a class="brand brand--light" href="/">
        <span class="brand__name">{site.shortName}</span>
        <span class="brand__sub">PRINTERS / NKUBU</span>
      </a>
      <button class="menu-close" id="menu-close" type="button" aria-label="Close menu">
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <nav aria-label="Mobile">
      <ol class="mobile-links">
        {nav.map((item, i) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="mobile-contact">
      <p class="eyebrow">Need a print job?</p>
      <a class="mobile-contact__row" href={waLink()} target="_blank" rel="noopener noreferrer">
        <span class="mobile-contact__label">WhatsApp</span>
        <span class="mobile-contact__value">{site.whatsapp.display} <span aria-hidden="true">&nearr;</span></span>
      </a>
      <a class="mobile-contact__row" href={`tel:${phone.tel}`}>
        <span class="mobile-contact__label">Call</span>
        <span class="mobile-contact__value">{phone.display}</span>
      </a>
      <address class="mobile-address">
        {site.address.lines.map((l) => <span>{l}</span>)}
      </address>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const closeBtn = document.getElementById('menu-close') as HTMLButtonElement | null;

  if (toggle && menu && closeBtn) {
    let timer: number | undefined;

    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close(true);
        return;
      }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      } else if (!menu.contains(active)) {
        e.preventDefault();
        first.focus();
      }
    };

    function open() {
      window.clearTimeout(timer);
      menu!.hidden = false;
      document.body.style.overflow = 'hidden';
      toggle!.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => {
        menu!.classList.add('is-open');
        closeBtn!.focus();
      });
      document.addEventListener('keydown', onKey);
    }

    function close(restoreFocus: boolean) {
      if (menu!.hidden) return;
      menu!.classList.remove('is-open');
      toggle!.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', onKey);
      document.body.style.overflow = '';
      timer = window.setTimeout(() => {
        menu!.hidden = true;
      }, 260);
      if (restoreFocus) toggle!.focus();
    }

    toggle.addEventListener('click', open);
    closeBtn.addEventListener('click', () => close(true));
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => close(false))
    );

    // If the viewport grows to desktop while the menu is open, close it.
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
      if (e.matches) close(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: var(--rule);
  }
  .site-header__bar {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand { display: inline-flex; flex-direction: column; text-decoration: none; line-height: 1; }
  .brand__name { font-weight: 800; font-size: 1.5rem; letter-spacing: -0.02em; }
  .brand__sub { margin-top: 0.3rem; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.18em; }
  .brand--light { color: var(--paper); }

  .desktop-nav, .header-wa { display: none; }

  .menu-toggle {
    display: inline-flex; align-items: center; gap: 0.6rem;
    min-height: 44px; padding: 0 0.9rem;
    background: transparent; border: var(--rule); border-radius: var(--radius);
    font-weight: 700; font-size: var(--step--1); letter-spacing: 0.1em; text-transform: uppercase;
    cursor: pointer;
  }
  .menu-toggle__bars { display: grid; gap: 5px; }
  .menu-toggle__bars i { display: block; width: 18px; height: 2px; background: currentColor; }

  @media (min-width: 900px) {
    .menu-toggle { display: none; }
    .desktop-nav { display: block; }
    .header-wa { display: inline-flex; }
    .desktop-nav ul { display: flex; gap: 2rem; list-style: none; margin: 0; padding: 0; }
    .desktop-nav a {
      display: inline-block; padding: 0.5rem 0;
      font-weight: 700; font-size: var(--step--1); letter-spacing: 0.1em; text-transform: uppercase;
      text-decoration: none; border-bottom: 3px solid transparent;
    }
    .desktop-nav a:hover { border-bottom-color: var(--yellow); }
    .desktop-nav a[aria-current='page'] { border-bottom-color: var(--ink); }
    .header-wa {
      align-items: center; gap: 0.4em; min-height: 44px; padding: 0 1rem;
      font-weight: 700; font-size: var(--step--1); letter-spacing: 0.1em; text-transform: uppercase;
      text-decoration: none; border: var(--rule); border-radius: var(--radius);
      transition: background-color .2s;
    }
    .header-wa:hover { background: var(--yellow); }
  }

  /* Full-screen mobile menu */
  .mobile-menu {
    position: fixed; inset: 0; z-index: 200;
    display: flex; flex-direction: column;
    overflow-y: auto; overscroll-behavior: contain;
    opacity: 0; transform: translateY(-8px);
    transition: opacity .25s ease, transform .25s ease;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu.is-open { opacity: 1; transform: none; }
  .mobile-menu__inner {
    width: 100%; max-width: var(--max); margin-inline: auto;
    padding: calc(1rem + env(safe-area-inset-top, 0px)) var(--gutter) calc(2rem + env(safe-area-inset-bottom, 0px));
    display: flex; flex-direction: column; flex: 1;
  }
  .mobile-menu__top { display: flex; justify-content: space-between; align-items: center; min-height: 3rem; }
  .menu-close {
    width: 48px; height: 48px; display: grid; place-items: center;
    background: transparent; border: 1px solid var(--paper); border-radius: var(--radius);
    font-size: 2rem; line-height: 1; cursor: pointer;
  }

  .mobile-links { list-style: none; margin: 2rem 0; padding: 0; }
  .mobile-links li { border-top: 1px solid rgb(245 242 234 / 0.2); }
  .mobile-links li:last-child { border-bottom: 1px solid rgb(245 242 234 / 0.2); }
  .mobile-links a {
    display: flex; align-items: baseline; gap: 1rem; padding: 0.9rem 0;
    font-weight: 800; font-size: clamp(1.9rem, 9vw, 3rem); letter-spacing: -0.02em;
    text-transform: uppercase; text-decoration: none; line-height: 1;
  }
  .mobile-links .num { font-size: var(--step--1); font-weight: 700; letter-spacing: 0.1em; color: var(--yellow); min-width: 1.6rem; }
  .mobile-links a[aria-current='page'] span:last-child { text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: 4px; text-underline-offset: 6px; }
  .mobile-links a:hover span:last-child { color: var(--yellow); }

  .mobile-contact { margin-top: auto; }
  .mobile-contact .eyebrow { color: var(--yellow); margin-bottom: 0.5rem; }
  .mobile-contact__row {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    min-height: 56px; border-top: 1px solid rgb(245 242 234 / 0.2); text-decoration: none;
  }
  .mobile-contact__label { font-size: var(--step--1); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .mobile-contact__value { font-weight: 800; font-size: var(--step-1); }
  .mobile-contact__row:hover .mobile-contact__value { color: var(--yellow); }
  .mobile-address {
    display: grid; gap: 0.15rem; padding-top: 1rem; border-top: 1px solid rgb(245 242 234 / 0.2);
    font-style: normal; font-size: var(--step--1); color: var(--grey-300);
  }
</style>