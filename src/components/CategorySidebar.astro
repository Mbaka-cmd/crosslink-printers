---
interface Props { cats: { slug: string; name: string; count: number }[]; total: number; }
const { cats, total } = Astro.props;
---
<aside class="side">
  <nav aria-label="Product categories">
    <p class="side__title">Categories</p>
    <ul class="side__list">
      <li><a href="/services" data-cat-link="all" aria-current="true"><span>All products</span><span class="count">{total}</span></a></li>
      {cats.map((c) => <li><a href={`/services?c=${c.slug}`} data-cat-link={c.slug}><span>{c.name}</span><span class="count">{c.count}</span></a></li>)}
    </ul>
  </nav>
</aside>
<nav class="chips" aria-label="Product categories">
  <ul>
    <li><a href="/services" data-cat-link="all" aria-current="true">All <span class="count">{total}</span></a></li>
    {cats.map((c) => <li><a href={`/services?c=${c.slug}`} data-cat-link={c.slug}>{c.name} <span class="count">{c.count}</span></a></li>)}
  </ul>
</nav>