---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { site, waLink, mapsLink } from '../data/site';
const phone = site.phones[0];
---
<BaseLayout title="Contact & Location | Crosslink Printers Nkubu" description="Contact Crosslink Printers in Nkubu by WhatsApp, phone or email. Along Mt Kenya University Street, opposite Rezama Chemist." path="/contact">
  <Header slot="header" />
  <PageHero eyebrow="Contact" title="Have something<br />to print?" lead="Tell us what you need to print." />
  <section class="section" id="visit">
    <div class="container">
      <div class="acts">
        <a class="act act--primary" href={waLink()} target="_blank" rel="noopener noreferrer"><span class="act__label">WhatsApp</span><span class="act__value">{site.whatsapp.display} <span aria-hidden="true">&nearr;</span><span class="visually-hidden"> (opens in a new tab)</span></span></a>
        <a class="act" href={`tel:${phone.tel}`}><span class="act__label">Call</span><span class="act__value">{phone.display}</span></a>
        <a class="act" href={mapsLink()} target="_blank" rel="noopener noreferrer"><span class="act__label">Get directions</span><span class="act__value">Open in Maps <span aria-hidden="true">&nearr;</span><span class="visually-hidden"> (opens in a new tab)</span></span></a>
      </div>
      <dl class="contact-list">
        <div><dt>Phone</dt><dd>{site.phones.map((p, i) => <><a href={`tel:${p.tel}`}>{p.display}</a>{i < site.phones.length - 1 && <br />}</>)}</dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>Location</dt><dd>Along Mt Kenya University Street<br />Opposite Rezama Chemist<br />Nkubu, Kenya</dd></div>
      </dl>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>