---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Page not found | Crosslink Printers" noindex>
  <Header slot="header" />
  <PageHero eyebrow="404" title="Page not<br />found." lead="That page doesn't exist. Head back home or message us on WhatsApp." />
  <section class="section"><div class="container"><a class="btn" href="/">Back to home <span class="arrow" aria-hidden="true">→</span></a></div></section>
  <Footer slot="footer" />
</BaseLayout>