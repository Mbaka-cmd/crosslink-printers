---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
import LocationSection from '../components/LocationSection.astro';
import FinalCTA from '../components/FinalCTA.astro';
---
<BaseLayout title="About | Crosslink Printers Nkubu" description="Crosslink Printers serves customers in Nkubu with printing, document, photography, computer and digital services." path="/about">
  <Header slot="header" />
  <PageHero eyebrow="About" title="Local.<br />Practical.<br />Print-focused." />
  <section class="section">
    <div class="container about">
      <Media name="storefront" ratio="4 / 3" sizes="(min-width: 900px) 45vw, 100vw" />
      <div class="prose">
        <p>Crosslink Printers serves customers in Nkubu with printing, document, photography, computer and digital services.</p>
        <p>From a single photocopy to professionally printed materials for a business, event or organisation, we provide a convenient place to get your work prepared and printed.</p>
      </div>
    </div>
  </section>
  <LocationSection />
  <FinalCTA />
  <Footer slot="footer" />
</BaseLayout>